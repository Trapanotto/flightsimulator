{
  "name": "trapanotto-flight-simulator",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "Arcade flight simulator over a streamed 3D Switzerland (swisstopo data, Three.js, Blender assets).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:route": "node tools/route-test.mjs",
    "assets": "node tools/build-aircraft.mjs",
    "test:flight": "node tools/flight-test.mjs",
    "benchmark": "node tools/benchmark.mjs",
    "assets:buildings": "blender -b --factory-startup -P tools/blender/build_buildings.py && node tools/optimize-aircraft.mjs build/buildings_raw.glb public/assets/buildings/buildings.glb && blender -b --factory-startup -P tools/blender/build_trees.py && node tools/optimize-aircraft.mjs build/trees_raw.glb public/assets/buildings/trees.glb"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "meshoptimizer": "^1.3.0",
    "pbf": "^5.1.2",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
