{
  "name": "trapanotto-flight-simulator",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "description": "Flight simulator in the browser over the real Switzerland (swisstopo data, Three.js on WebGPU).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "shots": "node tools/shots.mjs",
    "shots:update": "node tools/shots.mjs --update",
    "bench": "node tools/bench.mjs",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@preact/signals": "^2.11.4",
    "pbf": "^5.1.2",
    "preact": "^11.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
